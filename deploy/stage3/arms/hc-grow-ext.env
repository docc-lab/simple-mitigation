# hc-grow-ext: the victim harvests from the aggressors in the EXTRINSIC bursty scenario
# (motivation pass 3 add-on, user 2026-11-09). Victim on 4 threads 18-21
# (configs/motiv3-sm110p-ext4.yaml, GOMAXPROCS 4, limit 4), HC Primary pool = those 4 threads;
# the Secondary list is hc-hold's list minus the new Primary threads 20,21 and their SMT
# siblings 4,5, so the SN/SS aggressors are confined exactly as in hc-hold and additionally
# get threads 20,21 whenever the victim leaves them idle. hc-hold semantics (applied once at
# the enable, never released). Compare with hc-hold (2-thread pool) and none on the same
# 4-thread victim (4 exclusive cores).
ISO_ACTUATOR=hc
N_MAX=0
HC_VICTIM_CPULIST=18,19,20,21
HC_SECONDARY_CPULIST=0,1,6,7,8,9,10,11,12,13,16,17,22,23,24,25,26,27,28,29
HC_TARGET_IDLE_CORES=1
HC_LOW_TIC=1
HC_ACBF=0.33
HC_MIN_SECONDARY_CORES=0
HC_BALANCER_CPU=14
HC_THETA_ON=-1
HC_THETA_OFF=-2
HC_UP_WINDOWS=1
HC_DOWN_WINDOWS=1000000
