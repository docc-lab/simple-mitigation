# rep3 with the trigger FORCED at the ARM point (THETA_ON < 0 fires on the first
# armed tick): for scenarios the processing_time score cannot see (intrinsic
# overload; the handler stays flat while the run queue grows), the question
# is what 3 replica(s) achieve per core, not whether the score detects it.
# Same budget/placement rules as rep3.env; no scale-in during the run.
ISO_ACTUATOR=none
N_MAX=3
HORZ_FROM_EXT=0
HORZ_SIGNAL=e_iso
THETA_ON=-1
THETA_OFF=-2
HORZ_UP_WINDOWS=1
HORZ_DOWN_WINDOWS=1000000
HORIZONTAL_COOLDOWN_SEC=2
