# rep3p: REACTIVE replication with scale-IN (motivation pass 3 add-on, user 2026-11-09): the
# horizontal-any trigger (one tick of e_iso > THETA_ON steps search-overflow out by one, 2 s
# cooldown, up to N_MAX=3) plus scale-in after HORZ_DOWN_WINDOWS ticks (100 ms each) below
# THETA_OFF, so the replicas added for one burst are released before the next burst and every
# burst is handled reactively (rep3.env kept the replicas: later bursts were pre-provisioned).
ISO_ACTUATOR=none
N_MAX=3
HORZ_FROM_EXT=0
HORZ_SIGNAL=e_iso
THETA_ON=0.15
THETA_OFF=0.075
HORZ_UP_WINDOWS=1
HORZ_DOWN_WINDOWS=30
HORIZONTAL_COOLDOWN_SEC=2
