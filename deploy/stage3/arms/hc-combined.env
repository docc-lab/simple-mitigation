# HarvestContainers in place of isolation, plus scale-out (the combined
# arm with hc swapped in for isolate): once e_iso stays above
# HC_THETA_ON for HC_UP_WINDOWS ticks, the aggressors are confined to
# HC_SECONDARY_CPULIST plus whichever victim cores are idle (HC's Balancer);
# released after HC_DOWN_WINDOWS ticks below HC_THETA_OFF.
# Needs hc-listener running (qidlecpu loaded) on the node.
ISO_ACTUATOR=hc
HC_VICTIM_CPULIST=4,6
HC_SECONDARY_CPULIST=8,10,12,14
HC_TARGET_IDLE_CORES=1
HC_LOW_TIC=1
HC_ACBF=0.33
HC_MIN_SECONDARY_CORES=0
HC_BALANCER_CPU=28
HC_THETA_ON=0.35
HC_THETA_OFF=0.15
HC_UP_WINDOWS=3
HC_DOWN_WINDOWS=30
