# Scale-out on the SAME trigger as hc-bang: HORZ_SIGNAL=e_iso makes Eq.(1)
# read the extrinsic tail magnitude y90*ext90 (instead of the intrinsic y50
# channel), so replication is applied to extrinsic contention it cannot fix.
# This is the "unmatched mitigation" arm of the 2026-10 motivation
# experiment. One tick over THETA_ON steps search-overflow (common.env) out
# by one replica, up to N_MAX; scale-in after HORZ_DOWN_WINDOWS ticks
# (100 ms each) below THETA_OFF.
ISO_ACTUATOR=none
N_MAX=3
HORZ_FROM_EXT=0
HORZ_SIGNAL=e_iso
THETA_ON=0.15
THETA_OFF=0.075
HORZ_UP_WINDOWS=1
HORZ_DOWN_WINDOWS=30
