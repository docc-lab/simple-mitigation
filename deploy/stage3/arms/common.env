# Settings shared by every stage-3 arm (sourced by run-mitigation.sh before
# arms/<arm>.env, which overrides). Values are the 2026-07-13/14 sweep's,
# recovered from its controller logs ("FORMULA mode" line).

# Eq.(1) horizontal
THETA_ON=0.55
THETA_OFF=0.15
N_MAX=3
YHAT_FROM_CURRENT=1
HORZ_FROM_EXT=1
HORZ_THETA_ON=0.4
HORZ_THETA_OFF=0.15
HORZ_UP_WINDOWS=3
HORZ_DOWN_WINDOWS=30
HORIZONTAL_DEPLOYMENT=search-overflow

# Eq.(2) isolation
THETA_REF=0.35
K_P=18
K_I=0
# c_base = cores the aggressor set may use when e_iso is low. 8 was chosen
# for the SMT-on node (32 CPUs). With nosmt node-4 has 16: 0-1
# housekeeping, 2-4 victim, 12-15 controller + HC, which leaves 5-11 (7).
# Re-tune before trusting isolate numbers on the new node.
CAP_BASE_CORES=8
CAP_MIN_CORES=0
CAP_MIN_PER_POD_CORES=0
CAP_QUANTUM_CORES=0.5

# Aggressors: the orchestrator labels the config's aggressor pods.
AGGRESSOR_SELECTOR=gordion-aggr=true
AGGRESSOR_NAMESPACE=*

# Core the controller itself runs on (outside every arm's victim/aggressor set).
CONTROLLER_CPU=12
