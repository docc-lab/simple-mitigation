# Settings shared by every stage-3 arm (sourced by run-mitigation.sh before
# arms/<arm>.env, which overrides). Values are the 2026-07-13/14 sweep's,
# recovered from its controller logs ("FORMULA mode" line).

# Eq.(1) horizontal
THETA_ON=0.55
THETA_OFF=0.15
N_MAX=3
YHAT_FROM_CURRENT=1
HORZ_FROM_EXT=1
HORZ_THETA_ON=0.4
HORZ_THETA_OFF=0.15
HORZ_UP_WINDOWS=3
HORZ_DOWN_WINDOWS=30
HORIZONTAL_DEPLOYMENT=search-overflow

# Eq.(2) isolation
THETA_REF=0.35
# c_base = cores the aggressor set may use when e_iso is low. July used 8
# on the SMT-on sm110p (32 CPUs) with K_P=18, i.e. fully throttled at
# e_iso = THETA_REF + 8/18 = 0.79. node-4 is now 2x 8360Y, SMT off, all
# 72 cores online: minus 0,2 housekeeping, 4,6,8 victim and 24-30
# controller + HC leaves 63. K_P is scaled with c_base (63/0.44) so the
# cap still reaches 0 at the same e_iso as July.
K_P=142
K_I=0
CAP_BASE_CORES=63
CAP_MIN_CORES=0
CAP_MIN_PER_POD_CORES=0
CAP_QUANTUM_CORES=0.5

# Aggressors: the orchestrator labels the config's aggressor pods.
AGGRESSOR_SELECTOR=gordion-aggr=true
AGGRESSOR_NAMESPACE=*

# Core the controller itself runs on (outside every arm's victim/aggressor set).
CONTROLLER_CPU=24
