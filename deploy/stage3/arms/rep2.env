# Replication with a FIXED replica budget (motivation pass 2, 2026-11-01):
# horizontal-any's trigger (one tick of e_iso > THETA_ON steps search-overflow
# out by one) with N_MAX=2 and a 2 s per-deployment cooldown, so all 2
# replica(s) are up within the first armed burst; no scale-in during the run
# (HORZ_DOWN_WINDOWS huge) so the replica count is a constant of the cell.
# WHERE the replicas run is the overflow manifest's business
# (stage3-eval/motiv2/overflow-{samecores,othercores,othernode}.yaml).
ISO_ACTUATOR=none
N_MAX=2
HORZ_FROM_EXT=0
HORZ_SIGNAL=e_iso
THETA_ON=0.15
THETA_OFF=0.075
HORZ_UP_WINDOWS=1
HORZ_DOWN_WINDOWS=1000000
HORIZONTAL_COOLDOWN_SEC=2
