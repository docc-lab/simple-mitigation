# Replication WITHOUT a practical budget (motivation pass 2, user 2026-11-02:
# "let the controller create more replicas until it possibly achieves the
# target SLO"): same trigger as rep1-3 (one tick of e_iso > THETA_ON steps
# search-overflow out by one, 2 s per-deployment cooldown, no scale-in), cap
# raised to 6. Replication never lowers e_iso in the extrinsic scenario (the
# handler slowdown is per core), so the controller climbs to the cap; the cap
# is what the placement can host: othernodewide = 6 x 3-P replicas on node-3's
# 24 free threads, othercores = 6 replicas time-sharing node-4's threads 21-29.
ISO_ACTUATOR=none
N_MAX=6
HORZ_FROM_EXT=0
HORZ_SIGNAL=e_iso
THETA_ON=0.15
THETA_OFF=0.075
HORZ_UP_WINDOWS=1
HORZ_DOWN_WINDOWS=1000000
HORIZONTAL_COOLDOWN_SEC=2
